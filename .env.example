# ── VPS target (used by: make deploy / make connect) ─────────────────────────
# SSH destination for deploy and tunnel commands.
# Example: VPS_HOST=root@1.2.3.4
VPS_HOST=
# Local port bound by the SSH tunnel (docker binds this on the VPS loopback)
PROXY_PORT=5555

# ── Vault encryption (REQUIRED) ───────────────────────────────────────────────
# The surrogate→original vault is encrypted at rest. The proxy refuses to start
# without VAULT_KEY. DO NOT put it in this file — export it in your shell so the
# passphrase never lands on disk:
#     export VAULT_KEY="$(openssl rand -hex 32)"
# Keep it safe: if you lose it, the vault cannot be decrypted.
# VAULT_KEY=        # leave unset here; export it in the shell

# ── Proxy ─────────────────────────────────────────────────────────────────────
PORT=8080
# Local-only by default — loopback bind so the proxy is never reachable from the LAN.
HOST=127.0.0.1
# Shared secret — if set, Claude Code must use:
#   export ANTHROPIC_BASE_URL=http://localhost:8080/<PROXY_SECRET>
# Requests without the token in the path are rejected with 403.
# Generate a strong secret: openssl rand -hex 24
PROXY_SECRET=

# ── Outbound allowlist ────────────────────────────────────────────────────────
# The proxy only talks to the configured LLM upstreams (Anthropic / OpenAI /
# OpenRouter) and your local Ollama. Add extra hostnames here only if you use a
# custom gateway. Comma-separated. Anything else is blocked.
UPSTREAM_ALLOWLIST=

# ── Anthropic (Claude Code → /v1/messages) ────────────────────────────────────
ANTHROPIC_API_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY is forwarded transparently from Claude Code — do not set here

# ── OpenAI-compatible (OpenAI SDK / OpenRouter → /v1/chat/completions) ─────
OPENAI_API_URL=https://api.openai.com
# OPENAI_API_KEY is forwarded transparently from the client — do not set here
# OpenRouter: OPENAI_API_URL=https://openrouter.ai/api

# ── Ollama (local LLM — second anonymization layer) ───────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b        # qwen3:4b for better quality, slower
OLLAMA_TIMEOUT=30
LLM_ENABLED=true

# ── Engagement isolation ──────────────────────────────────────────────────────
# Change this for each new client. Keeps surrogate mappings isolated per engagement.
ENGAGEMENT_ID=default

# ── Storage ───────────────────────────────────────────────────────────────────
DATA_DIR=./data
DATABASE_PATH=./data/pii_vault.db

# ── Chunking (for long tool outputs like nmap scans) ─────────────────────────
LLM_CHUNK_SIZE=1500
LLM_CHUNK_OVERLAP=150
